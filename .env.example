# Application Configuration Template
# -------------------------------------------------------------
# Instructions:
# 1. Copy this file to .env:
#    Copy-Item .env.example .env
# 2. Fill in your MySQL user password for DB_PASSWORD
# 3. Load into your PowerShell session before running the app:
#    . .\Set-Env.ps1
#
# NEVER commit the .env file to version control.
# -------------------------------------------------------------

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=privacy_awareness_db
DB_USERNAME=privacy_user
DB_PASSWORD=YourPasswordHere

# Server Configuration
SERVER_PORT=8080

# Admin Bootstrap Account (Seeded on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@1234!
ADMIN_EMAIL=admin@privacysystem.local

# Hibernate Schema Update Mode (update safely updates tables without data loss)
JPA_DDL_AUTO=update